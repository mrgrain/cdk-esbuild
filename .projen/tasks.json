{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(npx -c \"node --print process.env.PATH\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bump": {
      "name": "bump",
      "description": "Bumps version based on latest git tag and generates a changelog entry",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^12"
      },
      "steps": [
        {
          "builtin": "release/resolve-latest-tag",
          "outputEnv": "LATEST_TAG"
        },
        {
          "spawn": "bump:releasable-commits",
          "outputEnv": "RELEASABLE_COMMITS",
          "condition": "git rev-parse --verify --quiet \"refs/tags/$LATEST_TAG\""
        },
        {
          "builtin": "release/suggest-version-bump",
          "outputEnv": "SUGGESTED_BUMP"
        },
        {
          "builtin": "release/apply-version-bump"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "bump:releasable-commits": {
      "name": "bump:releasable-commits",
      "description": "Print the releasable commits since the latest release",
      "steps": [
        {
          "exec": "git log --oneline $LATEST_TAG..HEAD"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "execArgs": [
            "git",
            "checkout",
            "-b",
            "scratch"
          ],
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compat": {
      "name": "compat",
      "description": "Perform API compatibility check against latest version",
      "steps": [
        {
          "execArgs": [
            "jsii-diff",
            "npm:@mrgrain/cdk-esbuild",
            "-k",
            "--ignore-file",
            ".compatignore"
          ]
        }
      ]
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "exec": "if [ ! -z ${CI} ]; then npx projen prepare:readme; fi",
          "shell": "system"
        },
        {
          "exec": "jsii --silence-warnings=reserved-word"
        },
        {
          "exec": "if [ ! -z ${CI} ]; then git checkout README.md; fi",
          "shell": "system"
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "execArgs": [
            "ts-node",
            "--project",
            "projenrc/tsconfig.json",
            ".projenrc.ts"
          ]
        }
      ]
    },
    "docgen": {
      "name": "docgen",
      "description": "Generate API.md from .jsii manifest",
      "steps": [
        {
          "execArgs": [
            "jsii-docgen",
            "-o",
            "API.md"
          ]
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "eslint": {
      "name": "eslint",
      "description": "Runs eslint against the codebase",
      "env": {
        "ESLINT_USE_FLAT_CONFIG": "false",
        "NODE_NO_WARNINGS": "1"
      },
      "steps": [
        {
          "execArgs": [
            "eslint",
            "--ext",
            ".ts,.tsx",
            "--fix",
            "--no-error-on-unmatched-pattern",
            "$@",
            "src",
            "test",
            "build-tools",
            "projenrc",
            ".projenrc.ts"
          ],
          "receiveArgs": true
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "npm install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "npm ci"
        }
      ]
    },
    "integ:go": {
      "name": "integ:go",
      "steps": [
        {
          "exec": "integ-runner --app=\"go run -mod=mod {filePath}\" --test-regex=\"^integ_.*\\.go$\"",
          "receiveArgs": true
        }
      ]
    },
    "integ:python": {
      "name": "integ:python",
      "steps": [
        {
          "exec": "pipenv sync"
        },
        {
          "exec": "integ-runner --app=\"pipenv run python {filePath}\" --test-regex=\"^integ-.*\\.py$\"",
          "receiveArgs": true
        }
      ]
    },
    "lint:ts": {
      "name": "lint:ts",
      "env": {
        "ESLINT_USE_FLAT_CONFIG": "false"
      },
      "steps": [
        {
          "exec": "npx eslint --ext .ts --fix $@",
          "receiveArgs": true
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "spawn": "package:js",
          "condition": "node -e \"if (!process.env.CI) process.exit(1)\""
        },
        {
          "spawn": "package-all",
          "condition": "node -e \"if (process.env.CI) process.exit(1)\""
        }
      ]
    },
    "package-all": {
      "name": "package-all",
      "description": "Packages artifacts for all target languages",
      "steps": [
        {
          "spawn": "package:js"
        },
        {
          "spawn": "package:java"
        },
        {
          "spawn": "package:python"
        },
        {
          "spawn": "package:dotnet"
        },
        {
          "spawn": "package:go"
        }
      ]
    },
    "package:dotnet": {
      "name": "package:dotnet",
      "description": "Create dotnet language bindings",
      "steps": [
        {
          "execArgs": [
            "jsii-pacmak",
            "-v",
            "--target",
            "dotnet"
          ]
        }
      ]
    },
    "package:go": {
      "name": "package:go",
      "description": "Create go language bindings",
      "env": {
        "JSII_BUILD_GO": "0"
      },
      "steps": [
        {
          "execArgs": [
            "jsii-pacmak",
            "-v",
            "--target",
            "go"
          ]
        }
      ]
    },
    "package:java": {
      "name": "package:java",
      "description": "Create java language bindings",
      "steps": [
        {
          "execArgs": [
            "jsii-pacmak",
            "-v",
            "--target",
            "java"
          ]
        }
      ]
    },
    "package:js": {
      "name": "package:js",
      "description": "Create js language bindings",
      "steps": [
        {
          "execArgs": [
            "jsii-pacmak",
            "-v",
            "--target",
            "js"
          ]
        }
      ]
    },
    "package:python": {
      "name": "package:python",
      "description": "Create python language bindings",
      "steps": [
        {
          "execArgs": [
            "jsii-pacmak",
            "-v",
            "--target",
            "python"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation",
      "steps": [
        {
          "spawn": "rosetta"
        },
        {
          "spawn": "docgen"
        }
      ]
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "prepare:readme": {
      "name": "prepare:readme",
      "steps": [
        {
          "exec": "sed -i -e '1,5d' -e '6i <img src=\"https://raw.githubusercontent.com/mrgrain/cdk-esbuild/main/images/wordmark.svg\" alt=\"cdk-esbuild\">' README.md"
        }
      ]
    },
    "publish:git:v5": {
      "name": "publish:git:v5",
      "description": "Prepends the release changelog onto the project changelog, creates a release commit, and tags the release",
      "env": {
        "CHANGELOG": "dist/changelog.md",
        "RELEASE_TAG_FILE": "dist/releasetag.txt",
        "PROJECT_CHANGELOG_FILE": "CHANGELOG.md",
        "VERSION_FILE": "dist/version.txt"
      },
      "steps": [
        {
          "builtin": "release/update-changelog"
        },
        {
          "builtin": "release/tag-version"
        },
        {
          "execArgs": [
            "git",
            "push",
            "--follow-tags",
            "origin",
            "v5"
          ]
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "release:v5": {
      "name": "release:v5",
      "description": "Prepare a release from \"v5\" branch",
      "env": {
        "RELEASE": "true",
        "MAJOR": "5"
      },
      "steps": [
        {
          "execArgs": [
            "rm",
            "-fr",
            "dist"
          ]
        },
        {
          "spawn": "bump"
        },
        {
          "spawn": "build"
        },
        {
          "spawn": "unbump"
        },
        {
          "exec": "git diff --ignore-space-at-eol --exit-code"
        }
      ]
    },
    "rosetta": {
      "name": "rosetta",
      "steps": [
        {
          "exec": "jsii-rosetta extract"
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "execArgs": [
            "jest",
            "--passWithNoTests",
            "--updateSnapshot"
          ],
          "receiveArgs": true
        },
        {
          "spawn": "eslint"
        }
      ]
    },
    "test:watch": {
      "name": "test:watch",
      "description": "Run jest in watch mode",
      "steps": [
        {
          "execArgs": [
            "jest",
            "--watch"
          ]
        }
      ]
    },
    "unbump": {
      "name": "unbump",
      "description": "Restores version to 0.0.0",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^12"
      },
      "steps": [
        {
          "builtin": "release/reset-version"
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "upgrade dependencies",
      "env": {
        "CI": "0"
      },
      "steps": [
        {
          "execArgs": [
            "npx",
            "npm-check-updates@20",
            "--upgrade",
            "--target=minor",
            "--peer",
            "--no-deprecated",
            "--dep=dev,prod,peer,optional",
            "--filter=@types/eslint,@types/jest,eslint-import-resolver-typescript,eslint-plugin-import,jest,jest-mock,jsii-diff,jsii-pacmak,projen,ts-jest,ts-morph,ts-node"
          ]
        },
        {
          "exec": "npm install"
        },
        {
          "execArgs": [
            "npm",
            "update",
            "@aws-cdk/aws-synthetics-alpha",
            "@aws-cdk/integ-runner",
            "@stylistic/eslint-plugin",
            "@types/eslint",
            "@types/jest",
            "@types/node",
            "@typescript-eslint/eslint-plugin",
            "@typescript-eslint/parser",
            "commit-and-tag-version",
            "esbuild",
            "eslint-import-resolver-typescript",
            "eslint-plugin-import",
            "eslint",
            "jest",
            "jest-junit",
            "jest-mock",
            "jsii-diff",
            "jsii-docgen",
            "jsii-pacmak",
            "jsii-rosetta",
            "jsii",
            "mrpj",
            "projen",
            "ts-jest",
            "ts-morph",
            "ts-node",
            "typescript",
            "aws-cdk-lib",
            "constructs"
          ]
        },
        {
          "exec": "npx projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watch & compile in the background",
      "steps": [
        {
          "exec": "jsii -w --silence-warnings=reserved-word"
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"npx projen\"."
}
